# Copy to .env.local and adjust as needed.
#
# Database (PostgreSQL required): Prisma reads `DATABASE_URL` from `prisma.config.ts`.
# Local: e.g. Supabase or Docker Postgres. Never commit real credentials.
# DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/lendly?sslmode=require"
# Optional: DATABASE_SSL_REJECT_UNAUTHORIZED=false (local TLS issues) or DATABASE_SSL_STRICT=true (enforce verify in prod)
#
# Local dev: optional auth bypass (see docs/LOCAL_QA_WORKFLOW.md)
# Set DEV_AUTH_BYPASS=true then set DEV_USER_ID to one of: admin-user | dev-user | qa-renter | qa-kyc-submitted | qa-kyc-rejected
DEV_AUTH_BYPASS=true
DEV_USER_ID=dev-user
DEV_USER_NAME=Your Name

# --- Local Google OAuth (required for "המשך עם Google" on /signin) ---
# Copy to .env.local and set real values. See docs/LOCAL_GOOGLE_AUTH.md for full setup.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-a-random-secret-at-least-32-chars
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# In Google Cloud Console (OAuth 2.0 Web application):
#   Authorized JavaScript origins:  http://localhost:3000
#   Authorized redirect URIs:        http://localhost:3000/api/auth/callback/google
#
# Production (Vercel): NEXTAUTH_URL must match the exact URL users open (https, no trailing slash),
# e.g. https://lendly.co.il — same host as in proxy/NEXTAUTH_URL (avoid mixing www vs apex).
# Add both origins to Google if you use www and non-www. If you see OAUTH_CALLBACK_ERROR / State cookie was missing,
# fix NEXTAUTH_URL + redirect URIs first; ephemeral OAuth cookies are extended in lib/auth/nextauth-options.ts.

# --- MangoPay (card payments) — when MANGOPAY_CLIENT_ID is set, checkout uses MangoPay ---
# Get credentials from MangoPay Dashboard (https://hub.mangopay.com)
# MANGOPAY_CLIENT_ID=your-client-id
# MANGOPAY_API_KEY=your-api-key
# MANGOPAY_API_URL=https://api.sandbox.mangopay.com  # production: https://api.mangopay.com
# MANGOPAY_PLATFORM_WALLET_ID=your-wallet-id         # wallet that receives pay-ins
# PAYMENTS_PROVIDER=mangopay        # optional: mangopay | manual_bit | mock
# Webhook URL (production): https://YOUR_DOMAIN/api/webhooks/mangopay
#   Register in MangoPay Dashboard → Notifications → Add webhook
#   Events: PAYIN_NORMAL_SUCCEEDED, PAYIN_NORMAL_FAILED
# Pilot: deposit is charged with rental; in-app release is status-only until MangoPay payouts.
#
# Manual Bit (pilot fallback when MangoPay is not configured):
# MANUAL_BIT_PAYMENT_URL=https://...

# Transactional email (Resend) – optional; if unset, emails are skipped
# RESEND_API_KEY=re_xxxx
# EMAIL_FROM=notifications@lendly.co.il
# APP_BASE_URL – base URL for links in emails. In development, defaults to http://localhost:3000 if unset.
# APP_BASE_URL=https://lendly.co.il
# ADMIN_EMAIL – optional; receives dispute-opened notifications when set
# ADMIN_EMAIL=admin@lendly.co.il

# Optional external error collector hook (Sentry-compatible via your own collector)
# OBSERVABILITY_FORWARD_ERRORS=true
# OBSERVABILITY_COLLECTOR_URL=https://your-observability-collector.example.com/events

# Listing photos in production use the same S3 bucket/credentials as KYC (prefix listings/).
# Served publicly via GET /api/listings/images/listings/{id}.jpg

# --- Production KYC storage (S3-compatible: AWS S3, R2, MinIO) ---
# Used when NODE_ENV=production for POST /api/kyc/upload and S3-backed reads (see lib/kyc-s3.ts).
# Do not put real secrets in this file — use .env.local (gitignored) or your host’s environment UI.
#
# KYC_S3_BUCKET=your-private-bucket-name
#   Where: AWS → S3 → Buckets → name you created (e.g. lendly-kyc-prod). Cloudflare → R2 → bucket name.
#   Create a dedicated private bucket; turn on “Block all public access” / no public ACLs.
#
# AWS_REGION=eu-north-1
#   Where: AWS → S3 → your bucket → “Properties” → “AWS Region” code (e.g. eu-west-1). Often same as where you create IAM users.
#   Alternatively set KYC_S3_REGION instead if you already use AWS_REGION for something else.
#
# KYC_S3_REGION=eu-north-1
#   Where: Same region code as above; use this only if you prefer not to set AWS_REGION.
#   You must set at least one of AWS_REGION or KYC_S3_REGION (non-empty) for production KYC uploads.
#
# AWS_ACCESS_KEY_ID=AKIA...
#   Where: AWS → IAM → Users → your app user → “Security credentials” → “Create access key” (Access key best for CLI/SDK).
#   Cloudflare R2 → R2 → “Manage R2 API Tokens” → create token with Object Read & Write → “Access Key ID” shown with the token.
#
# AWS_SECRET_ACCESS_KEY=...
#   Where: Shown once when you create the AWS access key pair, or with the R2 API token (“Secret Access Key”).
#   Omit both AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY only if the server gets credentials automatically (e.g. EC2/ECS task IAM role).
#
# KYC_S3_ENDPOINT=
#   Where: Cloudflare dashboard → R2 → “Overview” / account details → S3 API endpoint URL.
#   AWS S3: leave unset (SDK uses default regional endpoint). MinIO: your MinIO server base URL (e.g. https://minio.example.com).
#
# KYC_S3_FORCE_PATH_STYLE=false
#   Where: Not “found” in a console—set to true for MinIO and many S3-compatible providers; R2 often needs it with the endpoint above.
#   Omit or false for standard AWS S3 unless your provider docs say otherwise.

# Sentry (free tier supported)
# SENTRY_DSN=https://<key>@o0.ingest.sentry.io/<project_id>
# NEXT_PUBLIC_SENTRY_DSN=https://<key>@o0.ingest.sentry.io/<project_id>
# SENTRY_ORG=your-sentry-org-slug
# SENTRY_PROJECT=your-sentry-project-slug
